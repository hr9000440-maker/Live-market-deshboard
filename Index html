
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LIVE MARKET DASHBOARD</title>
<style>
*{box-sizing:border-box}
body{
margin:0;
font-family:Arial,sans-serif;
background:#0b1220;
color:white;
}
header{
background:#14243d;
padding:20px 10px;
text-align:center;
font-size:24px;
font-weight:bold;
color:#00e5ff;
}
.container{padding:15px}
h2{
color:#00e5ff;
border-bottom:1px solid #34445c;
padding-bottom:8px;
}
.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(145px,1fr));
gap:12px;
}
.card{
background:#17263d;
padding:18px 10px;
border-radius:12px;
text-align:center;
border:1px solid #30445f;
}
.card h3{font-size:16px;margin:5px}
.price{
font-size:21px;
font-weight:bold;
color:#00e5ff;
margin:10px 0;
}
.status{color:#ffcc00;font-size:13px}
footer{
text-align:center;
padding:20px;
color:#9aabc2;
font-size:12px;
}
</style>
</head>
<body>

<header>📊 LIVE MARKET DASHBOARD</header>

<div class="container">

<h2>🇮🇳 INDEX MARKET</h2>
<div class="grid">
<div class="card">
<h3>NIFTY 50</h3>
<div class="price">--</div>
<div class="status">Data Pending</div>
</div>

<div class="card">
<h3>BANK NIFTY</h3>
<div class="price">--</div>
<div class="status">Data Pending</div>
</div>

<div class="card">
<h3>SENSEX</h3>
<div class="price">--</div>
<div class="status">Data Pending</div>
</div>
</div>

<h2>📈 INDEX FUTURES</h2>
<div class="grid">
<div class="card">
<h3>NIFTY FUTURE</h3>
<div class="price">--</div>
<div class="status">Data Pending</div>
</div>
<div class="card">
<h3>BANK NIFTY FUTURE</h3>
<div class="price">--</div>
<div class="status">Data Pending</div>
</div>
</div>

<h2>⚡ INDEX OPTIONS</h2>
<div class="grid">
<div class="card">
<h3>NIFTY CALL / PUT</h3>
<div class="price">CE / PE</div>
<div class="status">Options Section</div>
</div>
<div class="card">
<h3>BANK NIFTY CALL / PUT</h3>
<div class="price">CE / PE</div>
<div class="status">Options Section</div>
</div>
</div>

<h2>🥇 MCX MARKET</h2>
<div class="grid">
<div class="card">
<h3>GOLD</h3>
<div class="price">--</div>
<div class="status">Data Pending</div>
</div>
<div class="card">
<h3>SILVER</h3>
<div class="price">--</div>
<div class="status">Data Pending</div>
</div>
<div class="card">
<h3>CRUDE OIL</h3>
<div class="price">--</div>
<div class="status">Data Pending</div>
</div>
</div>

<h2>📊 MCX FUTURES & OPTIONS</h2>
<div class="grid">
<div class="card">
<h3>MCX FUTURES</h3>
<div class="price">GOLD / SILVER</div>
<div class="status">Futures Section</div>
</div>
<div class="card">
<h3>MCX OPTIONS</h3>
<div class="price">CE / PE</div>
<div class="status">Options Section</div>
</div>
</div>

<footer>
LIVE MARKET DASHBOARD<br>
Prices require a connected live market data API.
</footer>
<script>
function updateTime(){
const now=new Date();
document.title="LIVE MARKET DASHBOARD";
}
updateTime();
setInterval(updateTime,1000);
</script>
</body>
</html>


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Live Market Dashboard</title>
<style>
body{margin:0;background:#101827;color:white;font-family:Arial;text-align:center}
header{background:#087b50;padding:20px;font-size:24px;font-weight:bold}
.card{background:#1e293b;margin:15px;padding:22px;border-radius:12px}
.price{font-size:27px;color:#00e69a}
.status{color:orange}
</style>
</head>
<body>
<header>LIVE MARKET DASHBOARD</header>
<div class="card">
<h2>NIFTY 50</h2>
<div class="price" id="nifty">--</div>
<div class="status">Connecting Soon</div>
</div>
<div class="card">
<h2>SENSEX</h2>
<div class="price" id="sensex">--</div>
<div class="status">Connecting Soon</div>
</div>
<div class="card">
<h2>MCX MARKET</h2>
<div class="price">--</div>
<div class="status">Connecting Soon</div>
</div>
<p>Live market data connection pending</p>

<div id="market">
  <h2>LIVE INDIAN MARKET DASHBOARD</h2>

  <div>
    <h3>NIFTY 50</h3>
    <p id="nifty">Waiting for live data...</p>
    <p id="niftySignal">Signal: WAIT</p>
  </div>

  <div>
    <h3>BANK NIFTY</h3>
    <p id="banknifty">Waiting for live data...</p>
    <p id="bankSignal">Signal: WAIT</p>
  </div>

  <div>
    <h3>SENSEX</h3>
    <p id="sensex">Waiting for live data...</p>
    <p id="sensexSignal">Signal: WAIT</p>
  </div>

  <div>
    <h3>MCX</h3>
    <p id="mcx">Waiting for live data...</p>
    <p id="mcxSignal">Signal: WAIT</p>
  </div>

  <p>15 Minute Candle Confirmation: Pending</p>
</div>
<script>
setInterval(() => {
  location.reload();
}, 60000);
</script>
</body>
</html>


